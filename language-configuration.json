{
  "comments": {
    "lineComment": "批.",
    "blockComment": [
      "解.",
      "释."
    ]
  },
  "brackets": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "（",
      "）"
    ],
    [
      "［",
      "］"
    ],
    [
      "{",
      "}"
    ],
    [
      "｛",
      "｝"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "(",
      "close": ")",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "[",
      "close": "]",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "（",
      "close": "）",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "［",
      "close": "］",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "'",
      "close": "'",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "‘",
      "close": "’",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "“",
      "close": "”",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "{",
      "close": "}",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "｛",
      "close": "｝",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "（",
      "）"
    ],
    [
      "［",
      "］"
    ],
    [
      "\"",
      "\""
    ],
    [
      "'",
      "'"
    ],
    [
      "‘",
      "’"
    ],
    [
      "“",
      "”"
    ],
    [
      "{",
      "}"
    ],
    [
      "｛",
      "｝"
    ]
  ],
  "indentationRules": {
    "increaseIndentPattern": "(?:^\\s*(?:(?:算|作|形)\\s+[^#'\"‘“]*[:：]|[^#'\"‘“]*\\s取\\s+(?:算|作)(?:\\s+[^#'\"‘“]*)?[:：]|若\\s+[^#'\"‘“]*\\s则|循(?:\\s+[^#'\"‘“]*\\s次)?|(?<![\\w\\u00C0-\\uFFFF])典\\s*[:：]|[^#\\'\"‘“]*\\s取\\s+典\\s*[:：]|试\\s*[:：]?|救\\s+[^#'\"‘“:：]+[:：]?|另)\\s*(?:(?:#|//).*)?$)|(?:^(?!.*(?://|(?:^|[^\\w\\u00C0-\\uFFFF])(?:批|解)[.。]))\\s*[^#\\'\"‘“{}｛｝]*(?:[{｛])\\s*(?:(?:#|//).*)?$)",
    "decreaseIndentPattern": "(?:^\\s*(?:(?:法|为|成|象|然|环|终)(?=\\s*(?:[.。,，)）\\]］]|#|//|$))|另(?=\\s|$)|救\\s))|(?:^\\s*[}｝])"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(?:典|[^#'\"‘“]*\\s取\\s+典)\\s*[:：]\\s*$",
      "afterText": "^\\s*成(?![\\w\\u00C0-\\uFFFF])",
      "action": {
        "indent": "indentOutdent"
      }
    },
    {
      "beforeText": "^(?!.*(?://|(?:^|[^\\w\\u00C0-\\uFFFF])(?:批|解)[.。]))[^#\\'\"‘“{}｛｝]*[{｛]\\s*$",
      "afterText": "^\\s*[}｝]",
      "action": {
        "indent": "indentOutdent"
      }
    }
  ]
}
