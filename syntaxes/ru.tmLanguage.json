{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "如言",
  "scopeName": "source.ru",
  "patterns": [
    {
      "name": "comment.line.ru",
      "match": "(#|//|(?<![\\p{L}\\p{N}_])批[.。]).*$"
    },
    {
      "name": "comment.block.ru",
      "begin": "(?<![\\p{L}\\p{N}_])解[.。]",
      "end": "释[.。]"
    },
    {
      "name": "string.quoted.ru",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.ru",
          "match": "\\\\[nrt\\\\\\'\"’”]"
        },
        {
          "name": "invalid.illegal.escape.ru",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.ru",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.ru",
          "match": "\\\\[nrt\\\\\\'\"’”]"
        },
        {
          "name": "invalid.illegal.escape.ru",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.ru",
      "begin": "‘",
      "end": "’",
      "patterns": [
        {
          "name": "constant.character.escape.ru",
          "match": "\\\\[nrt\\\\\\'\"’”]"
        },
        {
          "name": "invalid.illegal.escape.ru",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "string.quoted.ru",
      "begin": "“",
      "end": "”",
      "patterns": [
        {
          "name": "constant.character.escape.ru",
          "match": "\\\\[nrt\\\\\\'\"’”]"
        },
        {
          "name": "invalid.illegal.escape.ru",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "meta.import.named.ru",
      "begin": "(?<![\\p{L}\\p{N}_])(外言)(\\s+)((?!(?:显|取|为|得|完|破|若|则|另|然|循|次|环|算|作|法|其|且|或|非|空|真|假|典|成|对|形|象|如|新|外言|尽取|尽|试|救|卒)(?![\\p{L}\\p{N}_]))[\\p{L}_][\\p{L}\\p{N}_]*)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.ru"
        },
        "3": {
          "name": "entity.name.namespace.ru"
        }
      },
      "end": "(?=\\S)(?!其(?![\\p{L}\\p{N}_])|#|//|批[.。]|解[.。])",
      "patterns": [
        {
          "name": "comment.line.ru",
          "match": "(#|//|(?<![\\p{L}\\p{N}_])批[.。]).*$"
        },
        {
          "name": "comment.block.ru",
          "begin": "(?<![\\p{L}\\p{N}_])解[.。]",
          "end": "释[.。]"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])(其)(\\s+)((?!(?:显|取|为|得|完|破|若|则|另|然|循|次|环|算|作|法|其|且|或|非|空|真|假|典|成|对|形|象|如|新|外言|尽取|尽|试|救|卒)(?![\\p{L}\\p{N}_]))[\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": {
              "name": "keyword.operator.word.ru"
            },
            "3": {
              "name": "entity.name.namespace.ru"
            }
          }
        },
        {
          "match": "其(?![\\p{L}\\p{N}_])",
          "name": "keyword.operator.word.ru"
        }
      ]
    },
    {
      "match": "(?<![\\p{L}\\p{N}_])(其)(\\s+)(删|弹|查|排序|另成|逐位|逐目|三角形|多边形|平移|旋转|缩放|保存|恢复|变换|重置变换|裁剪|取消裁剪|颜色|文字对齐|经过秒|间隔秒|弧|扇形|折线|贝塞尔|缓存|贴图|宽|高)(?![\\p{L}\\p{N}_])",
      "captures": {
        "1": {
          "name": "keyword.operator.word.ru"
        },
        "3": {
          "name": "support.function.member.ru"
        }
      }
    },
    {
      "match": "(?<![\\p{L}\\p{N}_])(其)(\\s+)(段|落)(?![\\p{L}\\p{N}_])",
      "captures": {
        "1": {
          "name": "keyword.operator.word.ru"
        },
        "3": {
          "name": "variable.other.ru"
        }
      }
    },
    {
      "match": "(?<![\\p{L}\\p{N}_])(为)(\\s+)(典)(?![\\p{L}\\p{N}_])",
      "captures": {
        "1": {
          "name": "keyword.operator.word.ru"
        },
        "3": {
          "name": "storage.type.ru"
        }
      }
    },
    {
      "name": "meta.scope.ru",
      "begin": "(?:^\\s*|(?<=[.。{}｛｝])\\s*)(段)(\\s*[:：])",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.ru"
        },
        "2": {
          "name": "punctuation.separator.ru"
        }
      },
      "end": "(?<![\\p{L}\\p{N}_])落(?=\\s*[.。])",
      "endCaptures": {
        "0": {
          "name": "keyword.control.ru"
        }
      },
      "patterns": [
        {
          "include": "$self"
        }
      ]
    },
    {
      "name": "meta.map.ru",
      "begin": "(?<![\\p{L}\\p{N}_])(典)(\\s*[:：])",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.ru"
        },
        "2": {
          "name": "punctuation.separator.ru"
        }
      },
      "end": "(?<![\\p{L}\\p{N}_])成(?![\\p{L}\\p{N}_])",
      "endCaptures": {
        "0": {
          "name": "keyword.control.ru"
        }
      },
      "patterns": [
        {
          "include": "$self"
        }
      ]
    },
    {
      "name": "meta.braces.ru",
      "begin": "[{｛]",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.brackets.ru"
        }
      },
      "end": "[}｝]",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.brackets.ru"
        }
      },
      "patterns": [
        {
          "include": "$self"
        }
      ]
    },
    {
      "match": "(?<![\\p{L}\\p{N}_])(形)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
      "captures": {
        "1": {
          "name": "keyword.declaration.ru"
        },
        "2": {
          "name": "entity.name.type.ru"
        }
      }
    },
    {
      "match": "^(\\s*)(算|作)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)(?=\\s*[:：]|\\s+[\\p{L}_][^:：\\n]*[:：])",
      "captures": {
        "2": {
          "name": "keyword.declaration.ru"
        },
        "3": {
          "name": "entity.name.function.ru"
        }
      }
    },
    {
      "name": "constant.numeric.ru",
      "match": "(?<![\\p{L}\\p{N}_])(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?(?![\\p{L}\\p{N}_])"
    },
    {
      "name": "constant.language.ru",
      "match": "(?<![\\p{L}\\p{N}_])(?:空|真|假)(?![\\p{L}\\p{N}_])"
    },
    {
      "name": "keyword.operator.word.ru",
      "match": "(?<![\\p{L}\\p{N}_])(?:且|或|非|其|对|取|为)(?![\\p{L}\\p{N}_])"
    },
    {
      "name": "keyword.control.ru",
      "match": "(?<![\\p{L}\\p{N}_])(?:显|得|完|破|若|则|另|然|循|次|环|算|作|法|形|象|如|新|外言|尽取|尽|试|救|卒|成)(?![\\p{L}\\p{N}_])"
    },
    {
      "name": "keyword.control.end.ru",
      "match": "^\\s*终(?=\\s*(?:[.。]|#|//|$))"
    },
    {
      "name": "support.function.builtin.ru",
      "match": "(?<![\\p{L}\\p{N}_])(?:读|件|录|件作成果|读取|显出|错误|__如竞|__如观)(?![\\p{L}\\p{N}_])"
    },
    {
      "name": "keyword.operator.assignment.ru",
      "match": "[:：]="
    },
    {
      "name": "keyword.operator.ru",
      "match": "==|!=|<=|>=|[+*/%<>=@-]"
    },
    {
      "name": "punctuation.section.brackets.ru",
      "match": "[()\\[\\]（）［］]"
    },
    {
      "name": "punctuation.separator.ru",
      "match": "[,.：:。，]"
    },
    {
      "name": "storage.type.ru",
      "match": "(?<![\\p{L}\\p{N}_])(?:事实|典)(?![\\p{L}\\p{N}_])"
    },
    {
      "name": "variable.other.ru",
      "match": "[\\p{L}_][\\p{L}\\p{N}_]*"
    }
  ]
}
