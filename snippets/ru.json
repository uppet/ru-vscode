{
  "算定义": {
    "prefix": [
      "suan",
      "算"
    ],
    "body": [
      "算 ${1:平方} ${2:值} 为 ${3:数}:",
      "\t得 ${4:值 * 值}.",
      "法",
      "$0"
    ],
    "description": "有名函数"
  },
  "作定义": {
    "prefix": [
      "zuo",
      "作"
    ],
    "body": [
      "作 ${1:问候} ${2:名字} 为 ${3:句}:",
      "\t显 ${4:名字}.",
      "为",
      "$0"
    ],
    "description": "有名过程；Ru 0.8.0+ 自然结束或完. 均返回空"
  },
  "匿名算": {
    "prefix": [
      "lambda",
      "匿名算"
    ],
    "body": [
      "算 ${1:值} 为 ${2:数}:",
      "\t得 ${3:值 * 值}.",
      "法$0"
    ],
    "description": "匿名函数表达式；外层语句自行加句点"
  },
  "匿名作": {
    "prefix": [
      "proc",
      "匿名作"
    ],
    "body": [
      "作 ${1:值} 为 ${2:句}:",
      "\t显 ${3:值}.",
      "为$0"
    ],
    "description": "匿名过程表达式；外层语句自行加句点"
  },
  "条件": {
    "prefix": [
      "if",
      "若"
    ],
    "body": [
      "若 ${1:条件} 则",
      "\t${2:显 1.}",
      "另",
      "\t${3:显 0.}",
      "然",
      "$0"
    ],
    "description": "条件与分支"
  },
  "计次循环": {
    "prefix": [
      "loop",
      "循"
    ],
    "body": [
      "循 ${1:10} 次",
      "\t${2:显 1.}",
      "环",
      "$0"
    ],
    "description": "计次循环"
  },
  "恢复": {
    "prefix": [
      "try",
      "试"
    ],
    "body": [
      "试:",
      "\t${1:卒 '原因'.}",
      "救 ${2:原因}:",
      "\t显 ${2:原因}.",
      "终",
      "$0"
    ],
    "description": "只恢复显式卒"
  },
  "形定义": {
    "prefix": [
      "shape",
      "形"
    ],
    "body": [
      "形 ${1:点}:",
      "\t${2:横} 为 ${3:数}.",
      "象",
      "$0"
    ],
    "description": "声明类型名；使用新 点构造实例，形名不是普通值"
  },
  "入口": {
    "prefix": [
      "main",
      "元初"
    ],
    "body": [
      "算 元初 外参 为 句 阵:",
      "\t${1:显 '你好，如言！'.}",
      "\t得 0.",
      "法",
      "$0"
    ],
    "description": "带参数的程序入口"
  },
  "竞赛模板": {
    "prefix": [
      "contest",
      "竞赛"
    ],
    "body": [
      "尽 取 外言 '如:竞赛'.",
      "输入 取 读入.",
      "输出 取 蓄出.",
      "${1:值} 取 输入 其 数.",
      "输出 其 行 ${1:值}.",
      "输出 其 清.",
      "$0"
    ],
    "description": "竞赛缓冲输入输出"
  },
  "行注释": {
    "prefix": [
      "pi",
      "批"
    ],
    "body": [
      "批. ${1:说明}",
      "$0"
    ],
    "description": "中文行注释；到行末结束"
  },
  "块注释": {
    "prefix": [
      "jie",
      "解"
    ],
    "body": [
      "解.",
      "${1:说明}",
      "释.",
      "$0"
    ],
    "description": "中文块注释；不嵌套，以第一个释.结束"
  },
  "过程提前结束": {
    "prefix": [
      "wan",
      "完"
    ],
    "body": [
      "完.",
      "$0"
    ],
    "description": "Ru 0.8.0+：仅在作内提前正常结束，返回空；不带表达式，不替代为"
  },
  "算定义省略类型": {
    "prefix": [
      "suan-any",
      "算省略类型"
    ],
    "body": [
      "算 ${1:原样} ${2:值}:",
      "\t得 ${2:值}.",
      "法",
      "$0"
    ],
    "description": "Ru 0.9.0+：省略参数类型接受任何值（含空）；参数仍必传，显式类型仍检查"
  },
  "作定义省略类型": {
    "prefix": [
      "zuo-any",
      "作省略类型"
    ],
    "body": [
      "作 ${1:显示} ${2:值}:",
      "\t显 ${2:值}.",
      "为",
      "$0"
    ],
    "description": "Ru 0.9.0+：省略参数类型接受任何值（含空）；参数仍必传，显式类型仍检查"
  },
  "匿名算省略类型": {
    "prefix": [
      "lambda-any",
      "匿名算省略类型"
    ],
    "body": [
      "算 ${1:值}:",
      "\t得 ${1:值}.",
      "法$0"
    ],
    "description": "Ru 0.9.0+：省略参数类型接受任何值（含空）；参数仍必传，显式类型仍检查"
  },
  "匿名作省略类型": {
    "prefix": [
      "proc-any",
      "匿名作省略类型"
    ],
    "body": [
      "作 ${1:值}:",
      "\t显 ${1:值}.",
      "为$0"
    ],
    "description": "Ru 0.9.0+：省略参数类型接受任何值（含空）；参数仍必传，显式类型仍检查"
  },
  "混合参数定义": {
    "prefix": [
      "suan-mixed",
      "混合参数"
    ],
    "body": [
      "算 ${1:选择} ${2:值}, ${3:次数} 为 数:",
      "\t得 ${2:值}.",
      "法",
      "$0"
    ],
    "description": "Ru 0.9.0+：省略参数类型接受任何值（含空）；参数仍必传，显式类型仍检查"
  },
  "典字面量": {
    "prefix": [
      "dian",
      "典"
    ],
    "body": [
      "典:",
      "\t${1:‘上’} 对 ${2:0}.",
      "\t${3:‘下’} 对 ${4:2}.",
      "成$0"
    ],
    "description": "典表达式；无序映射，外层语句自行加句点；Ru 0.10.0+"
  },
  "空典": {
    "prefix": [
      "dian-empty",
      "空典"
    ],
    "body": [
      "典: 成$0"
    ],
    "description": "空典表达式；外层语句自行加句点；Ru 0.10.0+"
  },
  "事实参数": {
    "prefix": [
      "fact",
      "事实"
    ],
    "body": [
      "算 ${1:确认} ${2:值} 为 事实:",
      "\t得 ${2:值}.",
      "法",
      "$0"
    ],
    "description": "事实类型参数，真 / 假；仅空与假为假值；Ru 0.10.0+"
  },
  "典列回调": {
    "prefix": [
      "dian-each",
      "典列"
    ],
    "body": [
      "${1:表} 其 列 作 ${2:键}, ${3:值}:",
      "\t显 ${2:键}.",
      "\t显 ${3:值}.",
      "为.",
      "$0"
    ],
    "description": "按无序快照枚举键和值，回调可为算或作；Ru 0.10.0+"
  },
  "符号典": {
    "prefix": [
      "dian-symbol",
      "符号典"
    ],
    "body": [
      "{",
      "\t'${1:心}': ${2:0},",
      "\t'${3:意}': ${4:1}",
      "}$0"
    ],
    "description": "符号典表达式；与典/成等价，不是语句块；外层语句自行加句点"
  },
  "符号空典": {
    "prefix": [
      "dian-symbol-empty",
      "符号空典"
    ],
    "body": [
      "{}$0"
    ],
    "description": "空典表达式；等价于典: 成；外层语句自行加句点"
  }
}
