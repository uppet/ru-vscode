{
  "算定义": {
    "prefix": [
      "suan",
      "算"
    ],
    "body": [
      "算 ${1:平方} ${2:值} 为 ${3:数}:",
      "\t得 ${4:值 * 值}.",
      "法",
      "$0"
    ],
    "description": "有名函数"
  },
  "作定义": {
    "prefix": [
      "zuo",
      "作"
    ],
    "body": [
      "作 ${1:问候} ${2:名字} 为 ${3:句}:",
      "\t显 ${4:名字}.",
      "为",
      "$0"
    ],
    "description": "有名过程"
  },
  "匿名算": {
    "prefix": [
      "lambda",
      "匿名算"
    ],
    "body": [
      "算 ${1:值} 为 ${2:数}:",
      "\t得 ${3:值 * 值}.",
      "法$0"
    ],
    "description": "匿名函数表达式；外层语句自行加句点"
  },
  "匿名作": {
    "prefix": [
      "proc",
      "匿名作"
    ],
    "body": [
      "作 ${1:值} 为 ${2:句}:",
      "\t显 ${3:值}.",
      "为$0"
    ],
    "description": "匿名过程表达式；外层语句自行加句点"
  },
  "条件": {
    "prefix": [
      "if",
      "若"
    ],
    "body": [
      "若 ${1:条件} 则",
      "\t${2:显 1.}",
      "另",
      "\t${3:显 0.}",
      "然",
      "$0"
    ],
    "description": "条件与分支"
  },
  "计次循环": {
    "prefix": [
      "loop",
      "循"
    ],
    "body": [
      "循 ${1:10} 次",
      "\t${2:显 1.}",
      "环",
      "$0"
    ],
    "description": "计次循环"
  },
  "恢复": {
    "prefix": [
      "try",
      "试"
    ],
    "body": [
      "试:",
      "\t${1:卒 '原因'.}",
      "救 ${2:原因}:",
      "\t显 ${2:原因}.",
      "终",
      "$0"
    ],
    "description": "只恢复显式卒"
  },
  "形定义": {
    "prefix": [
      "shape",
      "形"
    ],
    "body": [
      "形 ${1:点}:",
      "\t${2:横} 为 ${3:数}.",
      "象",
      "$0"
    ],
    "description": "自定义形"
  },
  "入口": {
    "prefix": [
      "main",
      "元初"
    ],
    "body": [
      "算 元初 外参 为 句 阵:",
      "\t${1:显 '你好，如言！'.}",
      "\t得 0.",
      "法",
      "$0"
    ],
    "description": "带参数的程序入口"
  },
  "竞赛模板": {
    "prefix": [
      "contest",
      "竞赛"
    ],
    "body": [
      "尽 取 外言 '如:竞赛'.",
      "输入 取 读入.",
      "输出 取 蓄出.",
      "${1:值} 取 输入 其 数.",
      "输出 其 行 ${1:值}.",
      "输出 其 清.",
      "$0"
    ],
    "description": "竞赛缓冲输入输出"
  }
}
